<Layouts.public flash={@flash} current_scope={@current_scope}>
  <section class="mx-auto max-w-6xl px-4 sm:px-6 pt-16 pb-20 sm:pt-24 grid lg:grid-cols-2 gap-12 items-center">
    <div>
      <p class="inline-flex items-center gap-2 rounded-full bg-primary/10 text-primary text-xs font-medium px-3 py-1">
        <.icon name="hero-shield-check-mini" class="size-4" /> For Indian small businesses
      </p>
      <h1 class="mt-5 text-4xl sm:text-5xl font-semibold tracking-tight leading-tight">
        Know what is due before it becomes overdue.
      </h1>
      <p class="mt-5 text-lg text-base-content/70 max-w-xl">
        DueDesk keeps your renewals, licences, registrations, insurance and contracts in one place —
        with the dates, the documents and the person responsible — and reminds the right people in time.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <.link navigate={~p"/users/register"} class="btn btn-primary btn-lg">
          Start free
        </.link>
        <.link navigate={~p"/pricing"} class="btn btn-ghost btn-lg">
          See pricing
        </.link>
      </div>
      <p class="mt-4 text-sm text-base-content/60">Free plan. No card required.</p>
    </div>

    <div
      class="rounded-2xl border border-base-300 bg-base-200/60 p-4 sm:p-6 shadow-sm"
      aria-hidden="true"
    >
      <div class="grid grid-cols-3 gap-3 mb-4">
        <div class="rounded-xl bg-base-100 border border-base-300 p-3">
          <p class="text-xs text-base-content/60">Overdue</p>
          <p class="text-2xl font-semibold">1</p>
        </div>
        <div class="rounded-xl bg-base-100 border border-base-300 p-3">
          <p class="text-xs text-base-content/60">Due Soon</p>
          <p class="text-2xl font-semibold">3</p>
        </div>
        <div class="rounded-xl bg-base-100 border border-base-300 p-3">
          <p class="text-xs text-base-content/60">Up to Date</p>
          <p class="text-2xl font-semibold">24</p>
        </div>
      </div>
      <ul class="rounded-xl bg-base-100 border border-base-300 divide-y divide-base-300 text-sm">
        <li class="flex items-center justify-between gap-3 p-3">
          <div>
            <p class="font-medium">Fire safety NOC</p>
            <p class="text-xs text-base-content/60">Action due 02 Oct 2026 · Priya</p>
          </div>
          <.status_badge status={:overdue} />
        </li>
        <li class="flex items-center justify-between gap-3 p-3">
          <div>
            <p class="font-medium">Factory insurance renewal</p>
            <p class="text-xs text-base-content/60">Action due 20 Oct 2026 · Rahul</p>
          </div>
          <.status_badge status={:due_soon} />
        </li>
        <li class="flex items-center justify-between gap-3 p-3">
          <div>
            <p class="font-medium">Office rent agreement</p>
            <p class="text-xs text-base-content/60">Expires 31 Mar 2027 · Anita</p>
          </div>
          <.status_badge status={:up_to_date} />
        </li>
      </ul>
    </div>
  </section>

  <section class="border-t border-base-300/70 bg-base-200/50">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 py-16">
      <h2 class="text-2xl font-semibold tracking-tight text-center">
        Five questions, always answered
      </h2>
      <div class="mt-10 grid sm:grid-cols-2 lg:grid-cols-5 gap-4">
        <div
          :for={
            {icon, title, text} <- [
              {"hero-clipboard-document-list", "What is due?",
               "Every renewal and obligation as a DueItem."},
              {"hero-calendar-days", "When?", "Due and expiry dates with clear status."},
              {"hero-user-circle", "Who is responsible?", "One primary person, plus helpers."},
              {"hero-document-text", "Where are the documents?",
               "Kept with each DueItem, cycle by cycle."},
              {"hero-arrow-path", "What happened last time?", "Full history of every renewal."}
            ]
          }
          class="rounded-2xl bg-base-100 border border-base-300 p-5"
        >
          <.icon name={icon} class="size-6 text-primary" />
          <h3 class="mt-3 font-semibold">{title}</h3>
          <p class="mt-1 text-sm text-base-content/70">{text}</p>
        </div>
      </div>
    </div>
  </section>
</Layouts.public>
