<Layouts.public flash={@flash} current_scope={@current_scope}>
  <section class="mx-auto max-w-6xl px-4 sm:px-6 py-16 sm:py-20">
    <div class="text-center max-w-2xl mx-auto">
      <h1 class="text-4xl font-semibold tracking-tight">Simple pricing</h1>
      <p class="mt-4 text-lg text-base-content/70">
        Every plan includes the full DueDesk product. Plans differ only in how much you can store.
      </p>
    </div>

    <div class="mt-12 grid gap-6 md:grid-cols-3">
      <div
        :for={plan <- @plans}
        id={"plan-#{plan.code}"}
        class={[
          "rounded-2xl border bg-base-100 p-6 flex flex-col",
          if(plan.code == "business",
            do: "border-primary shadow-md ring-1 ring-primary",
            else: "border-base-300"
          )
        ]}
      >
        <h2 class="text-lg font-semibold">{plan.name}</h2>
        <p class="mt-4">
          <span class="text-4xl font-semibold">{inr(plan.monthly_inr)}</span>
          <span class="text-base-content/60">/ month</span>
        </p>
        <p class="mt-1 text-sm text-base-content/60 h-5">
          <%= if plan.annual_inr > 0 do %>
            or {inr(plan.annual_inr)} / year
          <% else %>
            No card required
          <% end %>
        </p>

        <p class="mt-6 text-sm font-medium text-success flex items-center gap-1">
          <.icon name="hero-check-circle-mini" class="size-4" />
          Core DueDesk functionality included
        </p>

        <ul class="mt-4 space-y-2 text-sm text-base-content/80 flex-1">
          <li>
            {if plan.max_organisations == :unlimited,
              do: "Unlimited Organisations",
              else:
                "#{plan.max_organisations} Organisation#{if plan.max_organisations > 1, do: "s"}"}
          </li>
          <li>{plan.max_due_items} active DueItems</li>
          <li>{plan.max_members} Admins &amp; Users</li>
          <li>
            {plan.max_super_admins} Super Admin{if plan.max_super_admins > 1, do: "s"}
          </li>
          <li>{DueDesk.Billing.Plans.format_bytes(plan.storage_bytes)} document storage</li>
        </ul>

        <.link
          navigate={~p"/users/register"}
          class={[
            "btn mt-6 w-full",
            if(plan.code == "business", do: "btn-primary", else: "btn-outline")
          ]}
        >
          {if plan.code == "free", do: "Start free", else: "Get started"}
        </.link>
      </div>
    </div>

    <p class="mt-10 text-center text-sm text-base-content/60">
      Prices in Indian Rupees. Start on Free and upgrade any time from your account.
    </p>
  </section>
</Layouts.public>
