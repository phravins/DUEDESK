<Layouts.auth flash={@flash}>
  <.auth_heading
    eyebrow="DueDesk internal"
    title="Operator console."
    tagline="Log in to continue."
  >
    Access to the operator console is restricted and recorded.
  </.auth_heading>

  <.form for={@form} id="operator_login_form" action={~p"/admin/log-in"}>
    <.input
      field={@form[:email]}
      type="email"
      label="Email"
      autocomplete="username"
      required
    />
    <.input
      field={@form[:password]}
      type="password"
      label="Password"
      autocomplete="current-password"
      required
    />
    <.button size="lg" class="mt-2 w-full">Continue</.button>
  </.form>
</Layouts.auth>
