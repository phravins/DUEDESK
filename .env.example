# DueDesk environment variables. Never commit real values.
#
# Local development: copy this file to `.env` (gitignored) and fill in the
# DB_* lines. config/config.exs loads `.env` in dev and test; variables set
# in your shell take priority.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=duedesk
DB_PASSWORD=

# Production: set the variables below in your host's secret store (they are
# commented out so a local `.env` copy doesn't pick them up).
# DATABASE_URL=ecto://USER:PASS@HOST/duedesk_prod
# SECRET_KEY_BASE=          # mix phx.gen.secret
# PHX_HOST=duedesk.in
# PHX_SERVER=true
# PORT=4000
# POOL_SIZE=10

# Document storage: a PRIVATE S3 or Cloudflare R2 bucket (no public access,
# no CORS needed; files pass through the app). For R2, S3_REGION=auto and
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com. For AWS S3,
# leave S3_ENDPOINT empty. Alternatively set UPLOADS_DIR to a persistent
# directory instead of the S3_* variables.
# S3_BUCKET=
# S3_REGION=auto
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# UPLOADS_DIR=/var/lib/duedesk/uploads

# Email (production): postmark, brevo, resend or mailgun. MAIL_DOMAIN is
# needed for mailgun only. Development uses the local mailbox (/dev/mailbox).
# MAIL_ADAPTER=postmark
# MAIL_API_KEY=
# MAIL_DOMAIN=
# MAIL_FROM=reminders@duedesk.in   # defaults to no-reply@duedesk.in

# WhatsApp reminders through an n8n webhook (optional). Without the URL
# the channel shows as unavailable. The signing secret is required with it.
# N8N_WEBHOOK_URL=
# N8N_SIGNING_SECRET=        # openssl rand -hex 32

# Added in later phases:
# Razorpay (Phase 6): RAZORPAY_KEY_ID, RAZORPAY_KEY_SECRET, RAZORPAY_WEBHOOK_SECRET
